{
  "expo": {
    "name": "Vuelto",
    "slug": "vuelto-pos",
    "version": "1.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/vuelto-icon.jpg",
    "splash": {
      "image": "./assets/vuelto-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#061426"
    },
    "android": {
      "package": "ve.vuelto.pos",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/vuelto-icon.jpg",
        "backgroundColor": "#061426"
      },
      "permissions": [
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ve.vuelto.pos",
      "infoPlist": {
        "NSCameraUsageDescription": "Escanear códigos de barras para buscar o agregar productos a la venta e inventario."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Escanear códigos de barras para buscar o agregar productos a la venta e inventario."
        }
      ]
    ]
  }
}
