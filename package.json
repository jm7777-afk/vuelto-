{
  "name": "vuelto-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Vuelto - Plataforma SaaS multi-tenant de facturación e inventario para comercios en Venezuela",
  "scripts": {
    "build": "npm run build:web && npm run build:backend",
    "build:backend": "npm --prefix backend run build",
    "build:web": "npm --prefix web run build && npm run sync:public",
    "sync:public": "node -e \"const fs=require('fs'),path=require('path');const pub=path.join('backend','public'),dist=path.join('web','dist');fs.rmSync(path.join(pub,'assets'),{recursive:true,force:true});fs.cpSync(dist,pub,{recursive:true,force:true});console.log('Synced web/dist -> backend/public');\"",
    "start": "npm --prefix backend start",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "test": "npm --prefix backend test",
    "test:backend": "npm --prefix backend test",
    "verify": "npm run build && npm run test"
  },
  "keywords": [
    "venezuela",
    "pos",
    "seniat",
    "facturacion",
    "inventario",
    "multi-tenant",
    "react-native",
    "express"
  ],
  "author": "Vuelto Team",
  "license": "UNLICENSED"
}
