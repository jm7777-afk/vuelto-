{
  "name": "vuelto-backend",
  "version": "1.0.0",
  "description": "API REST multi-tenant para el sistema de facturación e inventario Vuelto (Venezuela)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/migrate.ts",
    "db:check": "tsx src/db/check-connection.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.13.8",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^13.6.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.3",
    "zod": "^3.24.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.2",
    "react": "^19.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.0.4"
  }
}
