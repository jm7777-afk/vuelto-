# Puerto de escucha del servidor HTTP
PORT=4000

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=development

# Cadena de conexión PostgreSQL (PostgreSQL 16+)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vuelto_dev

# Claves criptográficas para emisión de tokens JWT (mínimo 32 caracteres)
JWT_SECRET=super-secret-jwt-key-vuelto-production-min32chars
JWT_REFRESH_SECRET=super-secret-refresh-key-vuelto-production-min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Habilitación de pasarela de pago simulada (debe ser 'false' en producción real)
MOCK_PAYMENT_ENABLED=false

# Credenciales de aprovisionamiento inicial (Seed seguro)
# OBLIGATORIAS en producción si se ejecuta 'npm run db:seed' o 'npm run db:migrate'
SEED_SUPERADMIN_USER=superadmin
SEED_SUPERADMIN_PASSWORD=GeneraUnaClaveFuerteSuperAdmin2026#
SEED_ADMIN_PASSWORD=GeneraUnaClaveFuerteAdminTienda2026#
SEED_CASHIER_PASSWORD=GeneraUnaClaveFuerteCajero2026#

# Nivel de logging (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Orígenes CORS permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,https://vuelto.onrender.com
