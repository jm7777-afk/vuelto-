# Puerto de escucha del servidor HTTP
PORT=4000

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=development

# Cadena de conexión PostgreSQL (PostgreSQL 16+ / Supabase)
# En producción usar un usuario de aplicación sin privilegios SUPERUSER ni BYPASSRLS
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vuelto_dev

# TLS / SSL PostgreSQL (en producción se valida el certificado por defecto)
# DATABASE_SSL_CA=/ruta/a/supabase-ca.crt
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Claves criptográficas para emisión de tokens JWT (mínimo 32 caracteres en producción)
JWT_SECRET=reemplazar-por-secreto-jwt-seguro-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=reemplazar-por-secreto-refresh-seguro-de-al-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Clave simétrica AES-256 para cifrado en reposo (secretos 2FA TOTP en base de datos)
ENCRYPTION_KEY=reemplazar-por-clave-aes-256-de-al-menos-32-caracteres

# Orígenes CORS exactos permitidos (separados por coma; NUNCA usar '*' en producción)
ALLOWED_ORIGINS=http://localhost:5173,https://vuelto.onrender.com

# Tokens internos obligatorios en producción (mínimo 16 caracteres)
METRICS_TOKEN=reemplazar-por-token-prometheus-seguro
PAYMENT_WEBHOOK_SECRET=reemplazar-por-secreto-hmac-pasarela
INTERNAL_ADMIN_TOKEN=reemplazar-por-token-diagnostico-seguro

# Habilitación de pasarela de pago simulada (SIEMPRE false en producción)
MOCK_PAYMENT_ENABLED=false

# Credenciales de aprovisionamiento inicial (Seed seguro)
SEED_SUPERADMIN_USER=superadmin
SEED_SUPERADMIN_PASSWORD=GeneraUnaClaveFuerteSuperAdmin2026#

# Nivel de logging (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
